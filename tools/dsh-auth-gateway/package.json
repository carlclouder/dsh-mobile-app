{
  "name": "dsh-auth-gateway",
  "version": "1.0.0",
  "description": "DSH 免令牌网关插件：在 dsh 进程内起一个本地反向代理（默认 127.0.0.1:3081），自动为转发请求注入有效会话 Cookie，使手机 App 用裸地址（不加 ?token=）即可远程访问。随 dsh 启动自动加载、随 dsh 退出自动关闭，无独立进程、无计划任务、无需改任何启动脚本。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "auth",
    "gateway",
    "tailscale"
  ],
  "license": "MIT",
  "author": "Carl",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
